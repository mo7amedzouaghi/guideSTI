      "niveau": 3,
      "motsClés": "événement clic cliquer bouton"
    },
    {
      "événement": "onfocus",
      "définition": "Se déclenche au moment où l'élément obtient le focus.",
      "exemple": "<input type=\"text\" id=\"cin\" onfocus=\"aide()\">",
      "paramètres": [
        {
          "nom": "valeur",
          "rôle": "Appel d'une fonction JavaScript : nomFonction()"
        }
      ],
      "niveau": 3,
      "motsClés": "événement focus entrer champ"
    },
    {
