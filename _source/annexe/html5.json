{
  "Éléments de 1er niveau": [
    {
      "balise": "<html>",
      "définition": "Représente la racine d'un document HTML.",
      "exemple": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Lycée Oued Ellil</title>\n</head>\n<body>\n  <h1>Bienvenue</h1>\n</body>\n</html>",
      "paramètres": [
        {
          "nom": "lang",
          "rôle": "Langue du contenu : fr, ar, en"
        }
      ],
      "remarques": [
        "<!DOCTYPE html> précède toujours <html>."
      ],
      "niveau": 2,
      "motsClés": "racine page document squelette structure doctype"
    },
    {
      "balise": "<head>",
      "définition": "Conteneur de métadonnées placé entre la balise <html> et la balise <body>.",
      "exemple": "<head>\n  <meta charset=\"UTF-8\">\n  <title>Découvrir la Tunisie</title>\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"css/style.css\">\n  <script type=\"text/javascript\" src=\"js/script.js\"></script>\n</head>",
      "remarques": [
        "Rien de ce qu'il contient n'est affiché dans la page, sauf le titre dans l'onglet."
      ],
      "niveau": 2,
      "motsClés": "en-tête document métadonnées"
    },
    {
      "balise": "<body>",
      "définition": "Définit le corps du document.",
      "exemple": "<body>\n  <h1>Lycée Oued Ellil</h1>\n  <p>Bienvenue sur notre site.</p>\n</body>",
      "remarques": [
        "onload s'écrit sur <body> : <body onload=\"init()\">."
      ],
      "niveau": 2,
      "motsClés": "corps contenu visible page"
    }
  ],
  "Éléments d'en-tête": [
    {
      "balise": "<link>",
      "définition": "Définit la relation entre le document actuel et une ressource externe.",
      "attributs": [
        "href",
        "rel",
        "type"
      ],
      "exemple": "<link rel=\"stylesheet\" type=\"text/css\" href=\"css/style.css\">",
      "paramètres": [
        {
          "nom": "rel",
          "rôle": "Relation avec la page : stylesheet pour une feuille de style"
        },
        {
          "nom": "type",
          "rôle": "Type du fichier : text/css"
        },
        {
          "nom": "href",
          "rôle": "Chemin du fichier relié"
        }
      ],
      "remarques": [
        "Niveau 3ème : le CSS externe n'est pas au programme de 2ème."
      ],
      "niveau": 3,
      "motsClés": "lier feuille de style css externe"
    },
    {
      "balise": "<meta>",
      "définition": "Définit les métadonnées du document.",
      "attributs": [
        "charset",
        "name",
        "content"
      ],
      "exemple": "<meta charset=\"UTF-8\">\n<meta name=\"description\" content=\"Site du club informatique\">\n<meta name=\"author\" content=\"Club info - Lycée Oued Ellil\">",
      "paramètres": [
        {
          "nom": "charset",
          "rôle": "Encodage des caractères : UTF-8"
        },
        {
          "nom": "name",
          "rôle": "Nom de la métadonnée : description, author, keywords"
        },
        {
          "nom": "content",
          "rôle": "Valeur de la métadonnée"
        }
      ],
      "remarques": [
        "Sans charset=\"UTF-8\", les lettres accentuées s'affichent mal."
      ],
      "niveau": 2,
      "motsClés": "encodage utf-8 description accents métadonnée"
    },
    {
      "balise": "<script>",
      "définition": "Intègre un script côté client (JavaScript).",
      "attributs": [
        "src",
        "type"
      ],
      "exemple": "<!-- fichier externe (obligatoire en 4ème) -->\n<script type=\"text/javascript\" src=\"js/controle.js\"></script>\n\n<!-- script interne (3ème) -->\n<script>\n  function saluer() {\n    alert(\"Bonjour\");\n  }\n</script>",
      "paramètres": [
        {
          "nom": "src",
          "rôle": "Chemin du fichier .js"
        },
        {
          "nom": "type",
          "rôle": "text/javascript (facultatif)"
        }
      ],
      "remarques": [
        "En 4ème, le JavaScript est obligatoirement dans un fichier externe.",
        "Une balise <script src=…> reste vide."
      ],
      "niveau": 3,
      "motsClés": "javascript script fichier js relier"
    },
    {
      "balise": "<style>",
      "définition": "Définit les informations de style (CSS) pour un document.",
      "attributs": [
        "type",
        "media"
      ],
      "exemple": "<style type=\"text/css\">\n  h1 {\n    color: navy;\n  }\n</style>",
      "paramètres": [
        {
          "nom": "type",
          "rôle": "text/css"
        },
        {
          "nom": "media",
          "rôle": "Support visé : screen, print"
        }
      ],
      "remarques": [
        "Se place dans <head>. CSS interne : niveau 2ème."
      ],
      "niveau": 2,
      "motsClés": "css interne style feuille dans la page"
    },
    {
      "balise": "<title>",
      "définition": "Définit le titre du document.",
      "exemple": "<title>Club informatique - Inscriptions</title>",
      "remarques": [
        "Obligatoire pour la validation W3C."
      ],
      "niveau": 2,
      "motsClés": "titre onglet navigateur favoris"
    }
  ],
  "Éléments de structuration d'une page web": [
    {
      "balise": "<header>",
      "définition": "Conteneur pour le contenu d'introduction ou un ensemble de liens de navigation.",
      "exemple": "<header>\n  <h1>Découvrir la Tunisie</h1>\n  <p>Le patrimoine de nos régions</p>\n</header>",
      "remarques": [
        "Balises sémantiques : niveau 3ème."
      ],
      "niveau": 3,
      "motsClés": "en-tête sémantique bandeau haut de page logo"
    },
    {
      "balise": "<nav>",
      "définition": "Définit un ensemble de liens de navigation.",
      "exemple": "<nav>\n  <a href=\"index.html\">Accueil</a>\n  <a href=\"regions.html\">Régions</a>\n  <a href=\"contact.html\">Contact</a>\n</nav>",
      "niveau": 3,
      "motsClés": "navigation menu liens sémantique"
    },
    {
      "balise": "<footer>",
      "définition": "Définit un pied de page pour un document ou une section.",
      "exemple": "<footer>\n  <address>Lycée Oued Ellil - Manouba</address>\n</footer>",
      "niveau": 3,
      "motsClés": "pied de page bas sémantique"
    },
    {
      "balise": "<section>",
      "définition": "Définit une section dans un document.",
      "exemple": "<section>\n  <h2>Sites archéologiques</h2>\n  <article>…</article>\n</section>",
      "niveau": 3,
      "motsClés": "section regroupement thématique sémantique"
    },
    {
      "balise": "<article>",
      "définition": "Spécifie un contenu indépendant et autonome.",
      "exemple": "<article>\n  <h3>Carthage</h3>\n  <p>Fondée au IXe siècle av. J.-C.</p>\n</article>",
      "niveau": 3,
      "motsClés": "article contenu autonome fiche sémantique"
    },
    {
      "balise": "<aside>",
      "définition": "Définit un contenu en dehors du contenu principal. Souvent placé sous forme de barre latérale.",
      "exemple": "<aside>\n  <h3>Le saviez-vous ?</h3>\n  <p>El Jem abrite le 3e plus grand amphithéâtre romain.</p>\n</aside>",
      "niveau": 3,
      "motsClés": "encadré contenu annexe latéral sémantique"
    },
    {
      "balise": "<main>",
      "définition": "Définit le contenu principal d'un document.",
      "exemple": "<main>\n  <h2>Nos activités</h2>\n  <p>…</p>\n</main>",
      "remarques": [
        "Un seul <main> par page."
      ],
      "niveau": 3,
      "motsClés": "contenu principal sémantique"
    }
  ],
  "Éléments de structuration de texte et média": [
    {
      "balise": "<cite>",
      "définition": "Définit le titre d'une œuvre.",
      "exemple": "<p>Notre livre du mois : <cite>Le Prophète</cite> de Gibran.</p>",
      "niveau": 3,
      "motsClés": "citation titre œuvre livre"
    },
    {
      "balise": "<p>",
      "définition": "Définit un paragraphe.",
      "exemple": "<p>Les inscriptions au club sont ouvertes jusqu'au 15 novembre.</p>",
      "niveau": 2,
      "motsClés": "paragraphe texte bloc"
    },
    {
      "balise": "<h1> à <h6>",
      "définition": "Définit un titre de niveau n (de 1 à 6).",
      "exemple": "<h1>Lycée Oued Ellil</h1>\n<h2>Clubs</h2>\n<h3>Club informatique</h3>",
      "remarques": [
        "Un seul <h1> par page ; ne pas sauter de niveau.",
        "Ne pas choisir un titre pour sa taille : la taille se règle en CSS."
      ],
      "niveau": 2,
      "motsClés": "titre sous-titre niveau hiérarchie"
    },
    {
      "balise": "<hr>",
      "définition": "Définit une rupture thématique sous forme de ligne horizontale.",
      "exemple": "<p>Première partie</p>\n<hr>\n<p>Deuxième partie</p>",
      "niveau": 2,
      "motsClés": "ligne séparation horizontale trait"
    },
    {
      "balise": "<img>",
      "définition": "Intègre une image.",
      "attributs": [
        "src",
        "alt"
      ],
      "exemple": "<img src=\"images/dougga.jpg\" alt=\"Théâtre romain de Dougga\" width=\"300\">",
      "paramètres": [
        {
          "nom": "src",
          "rôle": "Chemin du fichier image"
        },
        {
          "nom": "alt",
          "rôle": "Texte de remplacement (obligatoire)"
        }
      ],
      "remarques": [
        "Sans alt, la page n'est pas valide W3C.",
        "Les dimensions se règlent de préférence en CSS (width, height)."
      ],
      "niveau": 2,
      "motsClés": "image photo illustration"
    },
    {
      "balise": "<figure>",
      "définition": "Spécifie un conteneur autonome qui peut contenir divers éléments.",
      "exemple": "<figure>\n  <img src=\"images/eljem.jpg\" alt=\"Amphithéâtre d'El Jem\">\n  <figcaption>L'amphithéâtre d'El Jem</figcaption>\n</figure>",
      "niveau": 3,
      "motsClés": "figure illustration légende image"
    },
    {
      "balise": "<figcaption>",
      "définition": "Définit une légende pour un élément <figure>.",
      "exemple": "<figure>\n  <img src=\"carte.png\" alt=\"Carte des gouvernorats\">\n  <figcaption>Les 24 gouvernorats</figcaption>\n</figure>",
      "niveau": 3,
      "motsClés": "légende figure"
    },
    {
      "balise": "<audio>",
      "définition": "Intègre du contenu sonore dans un document.",
      "attributs": [
        "controls",
        "src"
      ],
      "exemple": "<audio src=\"sons/hymne.mp3\" controls></audio>",
      "paramètres": [
        {
          "nom": "src",
          "rôle": "Chemin du fichier audio (mp3)"
        },
        {
          "nom": "controls",
          "rôle": "Affiche les boutons lecture, pause, volume"
        }
      ],
      "remarques": [
        "<source> n'est pas dans l'annexe : le fichier est donné par l'attribut src.",
        "Sans controls, le lecteur est invisible."
      ],
      "niveau": 2,
      "motsClés": "son audio musique lecteur"
    },
    {
      "balise": "<video>",
      "définition": "Intègre du contenu vidéo dans un document.",
      "attributs": [
        "controls",
        "src"
      ],
      "exemple": "<video src=\"videos/visite.mp4\" controls width=\"400\"></video>",
      "paramètres": [
        {
          "nom": "src",
          "rôle": "Chemin du fichier vidéo (mp4)"
        },
        {
          "nom": "controls",
          "rôle": "Affiche les commandes de lecture"
        }
      ],
      "remarques": [
        "<source> n'est pas dans l'annexe : le fichier est donné par l'attribut src."
      ],
      "niveau": 2,
      "motsClés": "vidéo lecteur film"
    },
    {
      "balise": "<a>",
      "définition": "Définit un lien hypertexte via l'attribut href.",
      "attributs": [
        "href",
        "target"
      ],
      "exemple": "<a href=\"contact.html\">Contact</a>\n<a href=\"https://www.education.tn\" target=\"_blank\">Ministère</a>\n<a href=\"carthage.html\" target=\"cadre\">Carthage</a>",
      "paramètres": [
        {
          "nom": "href",
          "rôle": "Adresse de destination (page, fichier, URL)"
        },
        {
          "nom": "target",
          "rôle": "_self, _blank, _parent, _top, ou nom d'un iframe"
        }
      ],
      "niveau": 2,
      "motsClés": "lien hypertexte lien navigation url"
    },
    {
      "balise": "<br>",
      "définition": "Définit un retour à la ligne.",
      "exemple": "<p>Lycée Oued Ellil<br>Manouba</p>",
      "remarques": [
        "Ne sert pas à espacer des blocs : utiliser margin en CSS."
      ],
      "niveau": 2,
      "motsClés": "retour à la ligne saut de ligne"
    },
    {
      "balise": "<address>",
      "définition": "Définit les coordonnées de l'auteur/propriétaire d'un document ou d'un article.",
      "exemple": "<address>\n  Lycée Oued Ellil<br>\n  Tél. : 71 000 000\n</address>",
      "niveau": 3,
      "motsClés": "adresse contact coordonnées"
    },
    {
      "balise": "<details>",
      "définition": "Spécifie des détails supplémentaires que l'utilisateur peut ouvrir et fermer à la demande.",
      "attributs": [
        "open"
      ],
      "exemple": "<details>\n  <summary>Horaires</summary>\n  <p>Du lundi au samedi, de 8h à 18h.</p>\n</details>",
      "paramètres": [
        {
          "nom": "open",
          "rôle": "Bloc déplié dès l'affichage"
        }
      ],
      "niveau": 3,
      "motsClés": "dépliable replier cacher afficher plus"
    },
    {
      "balise": "<summary>",
      "définition": "Définit un en-tête visible pour l'élément <details>.",
      "exemple": "<details open>\n  <summary>Conditions d'inscription</summary>\n  <p>Être élève du lycée.</p>\n</details>",
      "niveau": 3,
      "motsClés": "titre bloc dépliable"
    }
  ],
  "Conteneurs": [
