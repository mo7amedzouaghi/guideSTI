  "Événements": [
    {
      "événement": "onblur",
      "définition": "Se déclenche au moment où l'élément perd le focus.",
      "exemple": "<input type=\"text\" id=\"nom\" onblur=\"verifierNom()\">",
      "paramètres": [
        {
          "nom": "valeur",
          "rôle": "Appel d'une fonction JavaScript : nomFonction()"
        }
      ],
      "niveau": 3,
      "motsClés": "événement perte focus quitter champ"
    },
    {
      "événement": "onclick",
      "définition": "Se déclenche lors d'un clic sur l'élément.",
      "exemple": "<input type=\"button\" value=\"Valider\" onclick=\"verifier()\">",
      "paramètres": [
        {
          "nom": "valeur",
          "rôle": "Appel d'une fonction JavaScript : nomFonction()"
        }
      ],
      "remarques": [
        "Le bouton est <input type=\"button\"> : <button> n'est pas dans l'annexe.",
        "addEventListener n'est pas au programme : l'événement s'écrit dans la balise."
